# Names only. Store real secret values in Airflow Connections or a secrets backend.
PROPERTY_TAX_ENVIRONMENT=local
PROPERTY_TAX_POSTGRES_CONN_ID=property_tax_postgres
PROPERTY_TAX_OBJECT_STORE_CONN_ID=property_tax_object_store
PROPERTY_TAX_BRONZE_BUCKET=property-tax-bronze
PROPERTY_TAX_BRONZE_PREFIX=releases
PROPERTY_TAX_LOG_LEVEL=INFO

# CountyForge review tooling. BWS_PROJECT_ID is an identifier, not a secret, and
# scopes the provider-credential lookup to the review project so the machine
# account cannot reach the runtime project's database passwords. BITWARDEN_TOKEN
# is a secret and belongs only in the git-ignored .env, never here.
BWS_PROJECT_ID=
