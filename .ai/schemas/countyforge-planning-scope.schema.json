{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CountyForge trusted planning scope policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "default_write_roots"],
  "properties": {
    "contract_version": { "type": "integer", "enum": [1] },
    "description": { "type": "string", "maxLength": 2000 },
    "default_write_roots": { "$ref": "#/$defs/write_roots" },
    "issues": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]{0,8}$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "write_roots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_roots"],
      "properties": {
        "write_roots": { "$ref": "#/$defs/write_roots" },
        "required_cross_issues": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "integer", "minimum": 1 }
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
