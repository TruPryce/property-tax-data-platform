{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TruPryce/property-tax-data-platform/.ai/schemas/countyforge-planning-publication-manifest.schema.json",
  "title": "CountyForge Planning Publication Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "change_name",
    "contract_version",
    "files",
    "implementation_eligibility",
    "implementation_readiness",
    "issue_number",
    "run_id",
    "target_sha",
    "trusted_context_freshness",
    "validation"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "change_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "branch": {
      "type": "string",
      "pattern": "^countyforge/plan/issue-[1-9][0-9]*-[a-z0-9]+(?:-[a-z0-9]+)*(?:-r[0-9a-f]{8})?$"
    },
    "target_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^openspec/changes/[a-z0-9]+(?:-[a-z0-9]+)*/.*$"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "gates"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "implementation_eligibility": {
      "const": false
    },
    "trusted_context_freshness": {
      "type": "object",
      "properties": {
        "compared": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "compared",
        "reason"
      ],
      "additionalProperties": false
    },
    "implementation_readiness": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": 1
        },
        "implementation_readable": {
          "const": true
        },
        "task_count": {
          "type": "integer",
          "minimum": 0
        },
        "task_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "checks_used": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "implementation_readable",
        "task_count"
      ],
      "additionalProperties": false
    }
  }
}
