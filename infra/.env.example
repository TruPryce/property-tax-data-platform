AIRFLOW_VERSION=3.3.0
AIRFLOW_PYTHON_VERSION=3.12
POSTGRES_VERSION=16.11
AIRFLOW_UID=50000
AIRFLOW_API_BIND_ADDRESS=127.0.0.1
AIRFLOW_API_PORT=8080
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
AIRFLOW_PARALLELISM=4
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=2
AIRFLOW_MAX_ACTIVE_RUNS_PER_DAG=1
AIRFLOW_ADMIN_USERNAME=airflow_admin

# pgBackRest identity. Non-secret: these name which AWS role the host may
# assume, not how to prove it. Proof is the workload certificate under
# TRUPRYCE_AWS_CERTIFICATE_DIR, which is mounted read-only and never copied
# into an image. The cipher passphrase is a Bitwarden secret and is not here.
TRUPRYCE_AWS_CERTIFICATE_DIR=/etc/trupryce/aws
# GID owning the certificate directory and private key. The PostgreSQL
# container joins it as a supplementary group so uid 999 can read a key that
# stays 0640. Numeric on purpose: the group has no name inside the image.
TRUPRYCE_AWS_GID=2000
TRUPRYCE_AWS_CERTIFICATE=/etc/trupryce/aws/trupryce-data-platform-vps.pem
TRUPRYCE_AWS_PRIVATE_KEY=/etc/trupryce/aws/trupryce-data-platform-vps.key
TRUPRYCE_AWS_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:099427795947:trust-anchor/63c0a64e-843d-4603-9f55-0ddc7045ecaa
TRUPRYCE_AWS_PROFILE_ARN=
TRUPRYCE_AWS_ROLE_ARN=arn:aws:iam::099427795947:role/trupryce-data-platform-backup
TRUPRYCE_AWS_DATA_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:099427795947:profile/REPLACE-WITH-DATA-PROFILE
TRUPRYCE_AWS_DATA_ROLE_ARN=arn:aws:iam::099427795947:role/trupryce-data-platform-vps
